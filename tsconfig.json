{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/shared/*": ["src/shared/*"],
      "@/features/*": ["src/features/*"]
    },
    // TypeScript 6 deprecates `baseUrl`; the path aliases above still work
    // without it in TS 7.0, but we keep both for editor/IDE compatibility
    // with older toolchains. Silences TS5101.
    "ignoreDeprecations": "6.0",
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals"]
  },
  "include": ["src", "scripts/*.d.ts"],
  "exclude": ["node_modules", "dist", "src-tauri", "dist-manual"]
}
