# =============================================================================
# hotseaters-ultimate environment variables
#
# HARD CONSTRAINT (see latest-data/.kbd-orchestrator/constraints.md):
#   Self-hosted Supabase only. Never point at *.supabase.co.
#
# Two acceptable VITE_SUPABASE_URL values:
#   1. http://localhost:8000     (local docker-compose stack in latest-data)
#   2. https://hotbase.prometheusags.ai  (hosted stack)
# =============================================================================

# Supabase (self-hosted — see RULE 1)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=replace-me

# Electric SQL (fronted by the Supabase Envoy gateway at /v1/shape;
# same origin as VITE_SUPABASE_URL so the browser hits one host in
# dev and prod, no Vite proxy involved).
VITE_ELECTRIC_URL=http://localhost:8000
# Production: https://hotbase.prometheusags.ai
# Shared API key sent as ?secret=… on every shape stream request.
# IS prefixed with VITE_ on purpose — gets shipped into the browser
# bundle so the client can authenticate. Tenant scope is enforced
# server-side by Postgres RLS, independent of this key.
VITE_ELECTRIC_SECRET=replace-me
# Kept for parity with latest-data/.env so a single value is the
# source of truth; not read by the app at runtime.
ELECTRIC_SECRET=replace-me

# OpenAI (for the manual-RAG embedding pipeline in Change 18; only used by scripts/, not the client)
# OPENAI_API_KEY=sk-...

# App
VITE_APP_NAME=HotSeaters
VITE_APP_VERSION=0.0.1
