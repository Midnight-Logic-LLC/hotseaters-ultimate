# =============================================================================
# hotseaters-ultimate environment variables
#
# HARD CONSTRAINT (see latest-data/.kbd-orchestrator/constraints.md):
#   Self-hosted Supabase only. Never point at *.supabase.co.
#
# Two acceptable VITE_SUPABASE_URL values:
#   1. http://localhost:8000     (local docker-compose stack in latest-data)
#   2. https://hotbase.prometheusags.ai  (hosted stack)
# =============================================================================

# Supabase (self-hosted — see RULE 1)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=replace-me

# Electric SQL (self-hosted)
VITE_ELECTRIC_URL=http://localhost:3133
# Production: https://electricsql.prometheusags.ai
# Server-only, used by Vite's local /v1 proxy when Electric is protected.
# Do not prefix with VITE_; this must not be bundled into the browser.
ELECTRIC_SECRET=replace-me

# OpenAI (for the manual-RAG embedding pipeline in Change 18; only used by scripts/, not the client)
# OPENAI_API_KEY=sk-...

# App
VITE_APP_NAME=HotSeaters
VITE_APP_VERSION=0.0.1
