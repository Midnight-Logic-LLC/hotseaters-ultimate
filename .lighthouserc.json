{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/docs/configuration.md",
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4321",
      "startServerReadyPattern": "Local:",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:4321/login",
        "http://localhost:4321/dashboard",
        "http://localhost:4321/clients",
        "http://localhost:4321/trials"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/dashboard.*",
          "assertions": {
            "categories:performance":   ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices":["error", { "minScore": 0.90 }],
            "categories:pwa":           ["warn",  { "minScore": 0.90 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "interaction-to-next-paint":["error", { "maxNumericValue": 200  }],
            "cumulative-layout-shift":  ["error", { "maxNumericValue": 0.05 }],
            "total-byte-weight":        ["warn",  { "maxNumericValue": 700000 }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance":   ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.90 }],
            "categories:best-practices":["error", { "minScore": 0.90 }],
            "categories:pwa":           ["warn",  { "minScore": 0.90 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "interaction-to-next-paint":["error", { "maxNumericValue": 200  }],
            "cumulative-layout-shift":  ["error", { "maxNumericValue": 0.05 }],
            "total-byte-weight":        ["warn",  { "maxNumericValue": 700000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
