{
  "name": "hotseaters-ultimate",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Precise PGlite + ElectricSQL + prometheus-entity-management port of HotSeatersMVP. Mobile-first PWA + Tauri. Self-hosted Supabase only.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm gen:pglite-schema && pnpm manual:compile && tsc -b && vite build",
    "preview": "vite preview --host --port ${HU_PORT:-5174}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rules": "node eslint-rules/_self-test.mjs",
    "lh": "lhci autorun",
    "size": "size-limit",
    "db:diff": "supabase db diff --schema public --linked",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:cucumber": "cucumber-js --config tests/cucumber/cucumber.cjs",
    "test:visual-parity": "playwright test --config tests/visual-parity/playwright.config.ts",
    "test:visual-parity:update": "playwright test --config tests/visual-parity/playwright.config.ts --update-snapshots",
    "test:bible-parity": "playwright test --config tests/visual-parity/bible-parity.config.ts",
    "test:db": "bash tests/db/run-pgtap.sh",
    "test:all": "pnpm test && pnpm test:db && pnpm test:e2e:smoke",
    "manual:compile": "node scripts/compile-user-manual-fragments.mjs",
    "manual:validate": "node scripts/validate-user-manual.mjs && node scripts/validate-user-manual-links.mjs",
    "manual:embed": "node scripts/embed-manual.mjs",
    "gen:pglite-schema": "node scripts/gen-pglite-schema.mjs",
    "gen:pglite-schema:check": "node scripts/gen-pglite-schema.mjs && git diff --exit-code src/shared/db/local-schema.sql",
    "gen:feature": "node scripts/gen-feature.mjs",
    "tauri": "tauri",
    "tauri:init": "tauri init",
    "tauri:dev": "tauri dev",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "verify:pglite-webview": "node scripts/verify-pglite-in-webview.mjs",
    "check:filenames": "node scripts/check-kebab-filenames.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@assistant-ui/react": "^0.12.0",
    "@assistant-ui/react-ai-sdk": "^1.3.0",
    "@assistant-ui/react-markdown": "^0.12.0",
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.3.13",
    "@electric-sql/pglite-react": "^0.2.34",
    "@electric-sql/pglite-sync": "^0.3.17",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.0.0",
    "@prometheus-ags/prometheus-entity-management": "link:../latest-data/packages/prometheus-entity-management",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@tiptap/extension-image": "^2.10.0",
    "@tiptap/extension-link": "^2.10.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "ai": "^4.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.16.4",
    "html2canvas": "^1.4.1",
    "immer": "^11.0.0",
    "input-otp": "^1.4.2",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "lucide-react": ">=1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.11.1",
    "react-router-dom": "^7.1.0",
    "recharts": "3.8.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.1.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/preset-app": "^11.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^15.11.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.0",
    "size-limit": "^11.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0"
}
